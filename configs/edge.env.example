# Edge Device Configuration (Raspberry Pi 4 Example)
# Copy to configs/edge.env on RPi4

# MQTT Broker (local to RPi4)
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883

# Cloud offload endpoint (Hospital Node MagicDNS or Tailscale IP)
CLOUD_OFFLOAD_URL=http://loq.your-tailnet.ts.net:8000/api/offload
CLOUD_CHAT_URL=http://loq.your-tailnet.ts.net:8001/api/chat

# Dashboard HTTP port
DASHBOARD_PORT=8080

# Cloud API Key for authentication
API_KEY=pm-edge-ac0008caeb077588ba481e57e1bde8af
