# Tailscale Virtual Local Mesh Configuration (Example Template)
# Copy this file to configs/network.env and update with your actual node credentials
TS_TAILNET_SUFFIX=your-tailnet.ts.net
EDGE_BROKER_HOST=rpi4-edge.your-tailnet.ts.net
EDGE_BROKER_PORT=1883
EDGE_API_URL=http://rpi4-edge.your-tailnet.ts.net:8080
CLOUD_INFERENCE_URL=http://loq.your-tailnet.ts.net:8000
CLOUD_CHAT_URL=http://loq.your-tailnet.ts.net:8001/api/chat

# Hostnames & Dynamic Identities (Tailscale MagicDNS)
RPI4_HOST=rpi4-edge.your-tailnet.ts.net
RPI4_USER=pi
RPI4_PASS=your-rpi-password
RPI4_FALLBACK_HOST=192.168.137.100

LOQ_HOST=loq.your-tailnet.ts.net
IDEAPAD_HOST=ideapads145.your-tailnet.ts.net
IDEAPAD_USER=your-user
IDEAPAD_PASS=your-patient-password

MQTT_BROKER=rpi4-edge.your-tailnet.ts.net
MQTT_PORT=1883

# Backward-compatibility aliases for legacy scripts
RPI4_IP=rpi4-edge.your-tailnet.ts.net
IDEAPAD_IP=ideapads145.your-tailnet.ts.net
