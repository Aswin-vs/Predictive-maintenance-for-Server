# Patient Server Configuration (Monitored Host Example)
# Copy to configs/server.env on the monitored machine

# MQTT Broker Host (RPi4 MagicDNS or IP)
MQTT_BROKER=rpi4-edge.your-tailnet.ts.net
MQTT_PORT=1883

# Telemetry collection interval (seconds)
TELEMETRY_INTERVAL=5

# Set to true only if running in simulated mode
USE_DUMMY=false
